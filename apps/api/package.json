{
  "name": "@automarket/api",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:s3": "node scripts/dev-s3.mjs",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node test/e2e.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:prueba": "tsx --env-file=.env prisma/seed-prueba.ts",
    "db:prueba:borrar": "tsx --env-file=.env prisma/borrar-prueba.ts",
    "mail:probar": "node scripts/probar-correo.mjs",
    "db:bootstrap-admin-one": "tsx --env-file=.env prisma/bootstrap-admin-one.ts",
    "db:studio": "prisma studio",
    "db:sql": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --output prisma/sql/schema.sql"
  },
  "dependencies": {
    "@automarket/contracts": "*",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.4",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "redis": "^6.3.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/smtp-server": "^3.5.13",
    "mysql-memory-server": "^1.18.0",
    "prisma": "^7.10.1",
    "smtp-server": "^3.21.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
