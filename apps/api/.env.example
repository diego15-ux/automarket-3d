NODE_ENV=development
PORT=4000
# Saltos de proxy de confianza delante de la API (para la IP real en rate limiting)
TRUST_PROXY=1
# URL pública de la web (enlaces de los correos y retorno desde Binance Pay)
WEB_URL=http://localhost:3000
ADMIN_ONE_EMAIL=

# MySQL 8.0.16+ o MariaDB 10.4+ (XAMPP). Base permanente en el MySQL/MariaDB de XAMPP:
#   crea la base (phpMyAdmin o: mysql -u root -e "CREATE DATABASE automarket3d CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci")
#   y luego: npm run db:deploy -w @automarket/api && npm run db:seed -w @automarket/api
# Tras crear la cuenta Admin One como ADMIN, configura ADMIN_ONE_EMAIL y ejecuta:
#   npm run db:bootstrap-admin-one -w @automarket/api
# El usuario root de XAMPP no tiene contraseña por defecto; si le pones una: mysql://root:CLAVE@127.0.0.1:3306/automarket3d
DATABASE_URL=mysql://root@127.0.0.1:3306/automarket3d
# Con TLS (RDS, PlanetScale, Azure…): mysql://user:pass@host:3306/automarket?ssl=true
DATABASE_POOL_SIZE=10

# Orígenes permitidos (separados por coma) para CORS y Socket.io
CORS_ORIGINS=http://localhost:3000

# Sesión. Genera secretos con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=automarket-api
JWT_AUDIENCE=automarket-web
PASSWORD_RESET_TTL_MINUTES=30
# COOKIE_DOMAIN=.automarket.com   # comparte la sesión entre app.automarket.com y api.automarket.com
# COOKIE_SECURE=true              # por defecto: true solo en producción

# Inicio de sesión con Google / Apple (ids de cliente separados por coma: web, iOS, Android)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Anti-bot: Cloudflare Turnstile (obligatorio en producción). Claves de prueba oficiales:
#   siempre pasa: 1x0000000000000000000000000000000AA · siempre falla: 2x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Correo transaccional (obligatorio en producción). docker compose incluye Mailpit:
#   SMTP_URL=smtp://localhost:1025  → bandeja en http://localhost:8025
# Sin SMTP_URL en desarrollo los correos se escriben en la consola.
SMTP_URL=
MAIL_FROM=AutoMarket <no-reply@automarket.dev>

# Almacenamiento S3 (buckets privados; el prefijo vehicles/ se sirve por CDN)
AWS_REGION=us-east-1
S3_BUCKET_MEDIA=automarket-media-dev
S3_BUCKET_KYC=automarket-kyc-dev
# S3_ENDPOINT=http://localhost:9000            # MinIO / LocalStack / npm run dev:s3
# MEDIA_PUBLIC_BASE_URL=https://cdn.automarket.com

# ── Pagos con Binance (los cobros llegan a la cuenta de Binance de la empresa) ──
# Moneda de cobro (1 USDT = 1 USD)
PAYMENT_CURRENCY=USDT
# Modo manual: el usuario paga a tu Pay ID con la referencia en la nota y un admin lo verifica
# en /admin/pagos. Tu Pay ID está en la app de Binance: Pay → (tu perfil) → Pay ID.
BINANCE_PAY_ID=
BINANCE_PAY_NAME=AutoMarket
# Imagen pública del QR de tu Pay ID (opcional), p. ej. http://localhost:3000/binance-qr.png
BINANCE_PAY_QR_IMAGE_URL=
MANUAL_PAYMENT_WINDOW_HOURS=24
# Modo comercio (Binance Pay Merchant, requiere cuenta verificada): QR automático + webhook.
# Claves en merchant.binance.com → Desarrolladores. Si las dejas vacías solo se ofrece el modo manual.
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_API_BASE=https://bpay.binanceapi.com
# URL pública de esta API: Binance Pay notifica los pagos en API_PUBLIC_URL/api/payments/binance/webhook
# API_PUBLIC_URL=https://api.tu-dominio.com

# Reservas y tareas programadas (caducidades, recordatorios, destacados)
CART_TTL_HOURS=48
JOBS_ENABLED=true
JOBS_INTERVAL_MS=60000

# Redis: rate limiting distribuido + adapter de Socket.io. Obligatorio en producción.
# REDIS_URL=redis://localhost:6379
