# URL pública de la API (navegador y Socket.io)
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL interna de la API para Server Components (si difiere de la pública, p. ej. en Docker)
# API_URL=http://api:4000

# Cloudflare Turnstile (anti-bot en registro, login, recuperación y contacto).
# Clave de prueba que siempre pasa (pareja de TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA en la API):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Host del CDN de las fotos de los anuncios (MEDIA_PUBLIC_BASE_URL de la API) para next/image
# NEXT_PUBLIC_MEDIA_HOST=cdn.automarket.com

# Inicio de sesión con Google / Apple (opcionales; sin ellos los botones se muestran desactivados)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=
# NEXT_PUBLIC_APPLE_REDIRECT_URI=https://app.automarket.com/login
