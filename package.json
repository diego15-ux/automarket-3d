{
  "name": "automarket-3d",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @automarket/contracts",
    "dev": "node scripts/dev-all.mjs",
    "dev:api": "npm run dev -w @automarket/api",
    "dev:web": "npm run dev -w @automarket/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @automarket/api"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
