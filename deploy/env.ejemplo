# AutoMarket 3D · claves del servidor. Lo más fácil: ./instalar.sh lo llena solo.
# A mano: copia este archivo como deploy/.env y llénalo.
# Nunca lo subas a internet ni lo compartas: tiene todas las claves.

# Tu dominio, sin https:// ni www (ej.: automarket.com). Necesitas dos registros DNS tipo A
# apuntando a la IP del servidor: el dominio y media.dominio.
DOMINIO=

# Correo de la cuenta que será el administrador principal (ADMIN_ONE).
ADMIN_ONE_EMAIL=

# Claves inventadas por ti: solo letras y números, 24 o más. En el servidor puedes generar una con:
#   openssl rand -hex 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_USER=automarket
MINIO_ROOT_PASSWORD=
# Esta, de 64:  openssl rand -hex 32
JWT_ACCESS_SECRET=

# Correo de salida (Brevo, Resend, Amazon SES o Gmail con contraseña de aplicación).
#   smtp://USUARIO:CLAVE@smtp-relay.brevo.com:587
#   smtps://tucorreo%40gmail.com:CLAVE_DE_APLICACION@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM="AutoMarket <no-reply@tudominio.com>"
# true = arrancar sin correo por ahora (la API lo recuerda al arrancar).
MAIL_DISABLED=false

# Cloudflare Turnstile (gratis): dash.cloudflare.com → Turnstile → agrega tu dominio.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# true = arrancar sin Turnstile por ahora (solo trampa anti-bot y límites).
TURNSTILE_DISABLED=false

# Opcional. «Entrar con Google»: el ID de cliente de Google Cloud (con https://tudominio en
# «Orígenes autorizados de JavaScript»). Vacío = sin botón de Google.
GOOGLE_CLIENT_ID=

# Opcional. Solo si en el panel todavía no hay un Pay ID de Binance (el panel manda).
BINANCE_PAY_ID=
